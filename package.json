{
  "name": "gorengan-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SHARED,SERVER,WEB\" -c \"yellow,cyan,magenta\" \"pnpm --filter @gorengan/shared dev\" \"pnpm --filter @gorengan/market-server dev\" \"pnpm --filter web dev\"",
    "dev:server": "pnpm --filter @gorengan/market-server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "symbols:add": "node scripts/bulk-add-symbols.mjs",
    "tail": "node scripts/tail-market.mjs",
    "tail:trades": "node scripts/tail-market.mjs --trades-only",
    "tail:whales": "node scripts/tail-market.mjs --trades-only --min-value=5000",
    "tail:tickers": "node scripts/tail-market.mjs --tickers-only",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "js-yaml": ">=4.3.2",
      "postcss": ">=8.5.23",
      "baseline-browser-mapping": ">=2.11.0"
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "pg": "^8.23.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.1.1"
}
