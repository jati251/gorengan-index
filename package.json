{
  "name": "gorengan-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @gorengan/shared build && concurrently -k -p \"[{name}]\" -n \"SHARED,SERVER,WEB\" -c \"yellow,cyan,magenta\" \"pnpm --filter @gorengan/shared dev\" \"pnpm --filter @gorengan/market-server dev\" \"pnpm --filter web dev\"",
    "dev:server": "pnpm --filter @gorengan/market-server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.1.1"
}
