# Google OAuth Credentials
# Obtain these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth / Auth.js Configuration
# Secret key used to encrypt JWT cookies and session tokens.
# Generate one using: openssl rand -base64 32
AUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters
NEXTAUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters

# Base URL of the web application
NEXTAUTH_URL=http://localhost:3000

# Development Auth Bypass (Set to true to bypass Google OAuth in development)
AUTH_BYPASS=true
NEXT_PUBLIC_AUTH_BYPASS=true

# Standalone TypeScript market-server (used by the current web client)
NEXT_PUBLIC_API_URL=http://localhost:9000/v1
NEXT_PUBLIC_WS_URL=ws://localhost:9000/v1/stream

# Optional: SEC archive XML requests require a real application/contact identity.
# SEC_USER_AGENT=YourApp contact@your-domain.example
# Optional public Bitcoin addresses, comma-separated, maximum 20.
# BITCOIN_WATCH_ADDRESSES=
