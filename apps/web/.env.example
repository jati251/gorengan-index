# Google OAuth Credentials
# Obtain these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth / Auth.js Configuration
# Secret key used to encrypt JWT cookies and session tokens.
# Generate one using: openssl rand -base64 32
AUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters
NEXTAUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters

# Base URL of the web application
NEXTAUTH_URL=http://localhost:3000

# Development Auth Bypass (Set to true to bypass Google OAuth in development)
AUTH_BYPASS=true
NEXT_PUBLIC_AUTH_BYPASS=true

# Backend Services
NEXT_PUBLIC_GATEWAY_HTTP_URL=http://localhost:8080
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8080/ws
